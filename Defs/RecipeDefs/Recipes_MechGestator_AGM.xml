  <!-- Light tier - available straight after basic mechtech -->
  <RecipeDef ParentName="LightMechanoidRecipe">
    <defName>AGM_GestateTerminus</defName>
    <label>gestate Terminus</label>
    <description>Gestate Terminus: a tiny, tireless all-purpose worker maidnoid. The smallest model in the AGM line, and the cheapest to feed.</description>
