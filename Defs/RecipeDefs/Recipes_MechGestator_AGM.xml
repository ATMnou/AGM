  <!--   Light 15-60, Medium 45-120, Heavy 120-240, Leviathan 600.  -->
  <!-- ============================================================ -->

  <!-- Light tier - available straight after basic mechtech -->
  <RecipeDef ParentName="LightMechanoidRecipe">
    <defName>AGM_GestateTerminus</defName>
    <label>gestate Terminus</label>
    <description>Gestate Terminus: a tiny, tireless all-purpose worker maidnoid. The smallest model in the AGM line, and the cheapest to feed.</description>
    <researchPrerequisite>BasicMechtech</researchPrerequisite>
    <displayPriority>501</displayPriority>
    <recipeUsers>
      <li>AGM_GeneralMechGestator</li>
    </recipeUsers>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>AGM_IOToken</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <products>
      <AGM_Terminus>1</AGM_Terminus>
    </products>
    <descriptionHyperlinks>
      <ThingDef>AGM_Terminus</ThingDef>
      <ThingDef>AGM_IOToken</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>

