<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================ -->
  <!-- Mythos techniques - verbatim Def ports of the Glitterworld Destroyer -->
  <!-- mod's Annihilator abilities (workshop 3550544871, Odyssey/Defs/AbilityDefs/ -->
  <!-- AbilitiesOdyssey.xml), renamed to the AGM_ prefix. Sounds/icons -->
  <!-- are the original mod's own assets, rehosted locally. -->
  <!-- ============================================================ -->

  <!-- 도약 (원본 Annihilator_JumpAbility) -->
  <AbilityDef>
    <defName>AGM_MythosJump</defName>
    <label>jump</label>
    <description>Leap high and land at the target location, dealing terrifying crushing damage to the enemies within the landing spot.</description>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <iconPath>Misc/Mythos_Jump</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <showWhenDrafted>true</showWhenDrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>-1</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <range>500</range>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityEffect">
        <compClass>AGM.CompAbilityEffect_MythosJump</compClass>
      </li>
    </comps>
  </AbilityDef>

  <!-- 플라스마 소탕 (원본 Annihilator_Suspend) -->
  <AbilityDef>
    <defName>AGM_MythosSuspend</defName>
    <label>plasma sweep</label>
    <description>Activate the grav engine, suspend and spray plasma downward to clean up all objects within the range.</description>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <iconPath>Misc/Mythos_Suspend</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <targetRequired>false</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <showWhenDrafted>true</showWhenDrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>-1</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetSelf>true</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityEffect">
        <compClass>AGM.CompAbilityEffect_MythosSuspend</compClass>
      </li>
    </comps>
  </AbilityDef>

  <!-- 도약 후 소탕 (원본 Annihilator_JumpAndSuspend) -->
  <AbilityDef>
    <defName>AGM_MythosJumpAndSuspend</defName>
    <label>jump to sweep</label>
    <description>Leap high and turns into a suspended state above the target location, spraying plasma for sweeping.</description>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <iconPath>Misc/Mythos_JumpAndSuspend</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <showWhenDrafted>true</showWhenDrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>-1</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <range>500</range>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityEffect">
        <compClass>AGM.CompAbilityEffect_MythosJumpAndSuspend</compClass>
      </li>
    </comps>
  </AbilityDef>

</Defs>
