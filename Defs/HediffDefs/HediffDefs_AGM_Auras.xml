<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Batch-2 aura/self hediffs. All self-expire; their auras refresh them. -->

  <HediffDef>
    <defName>AGM_Hediff_CommandAura</defName>
    <label>command presence</label>
    <description>Command A+'s projected battlefield presence steadies everyone under it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.85, 0.4)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>AGM_Hediff_MimoSync</defName>
    <label>ecosystem sync</label>
    <description>Mimo's link radius keeps every tool in the colony running a little faster.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.45, 0.1)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>+0.10</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>AGM_Hediff_MuseInspiration</defName>
    <label>muse spark</label>
    <description>Standing in Muse Spark's inspiration field. The world reads like a first draft worth finishing.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.6, 0.9)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>+0.15</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>AGM_Hediff_QwenIdol</defName>
    <label>idol protocol</label>
    <description>Qwen's idol broadcast is running. Morale is mandatory.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 1.0, 0.7)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>AGM_Hediff_MercuryOverdrive</defName>
    <label>data overdrive</label>
    <description>Mercury's targeting core is sharing live firing solutions. Everything is a little faster and a little more accurate.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.9, 1.0)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <MoveSpeed>+0.4</MoveSpeed>
          <ShootingAccuracyPawn>+0.15</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

</Defs>
