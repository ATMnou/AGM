<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BaseGun">
    <defName>AGM_Gun_ThermalLances</defName>
    <label>Thermal Lances</label>
    <description>A set of high-energy gamma ray lasers that emit a sweeping beam that can penetrate even the thickest armor and vaporize any organism within range, no matter how strong the armor they are wearing.</description>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <relicChance>0</relicChance>
    <graphicData>
      <texPath>Things/Weapon/ThermalLances</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5.0, 5.0)</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>40000</WorkToMake>
      <Mass>4</Mass>
      <AccuracyTouch>2.00</AccuracyTouch>
      <AccuracyShort>2.00</AccuracyShort>
      <AccuracyMedium>2.00</AccuracyMedium>
      <AccuracyLong>2.00</AccuracyLong>
      <RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
    </statBases>
    <equippedAngleOffset>-53</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>Verb_ShootBeam</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <warmupTime>0.0</warmupTime>
        <range>45.0</range>
        <minRange>1</minRange>
        <beamFullWidthRange>9.0</beamFullWidthRange>
        <burstShotCount>100</burstShotCount>
        <showBurstShotStats>false</showBurstShotStats>
        <beamWidth>6</beamWidth>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <beamDamageDef>Beam</beamDamageDef>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <soundCastBeam>BeamGraser_Shooting</soundCastBeam>
        <beamGroundFleckDef>Fleck_BeamBurn</beamGroundFleckDef>
        <beamFleckChancePerTick>0.32</beamFleckChancePerTick>
        <beamMaxDeviation>0</beamMaxDeviation>
        <beamCurvature>0.9</beamCurvature>
        <beamMoteDef>Mote_GraserBeamBase</beamMoteDef>
        <beamEndEffecterDef>GraserBeam_End</beamEndEffecterDef>
        <beamChanceToStartFire>1.0</beamChanceToStartFire>
        <beamChanceToAttachFire>1.0</beamChanceToAttachFire>
        <beamFireSizeRange>1.0</beamFireSizeRange>
        <beamLineFleckDef>Fleck_BeamSpark</beamLineFleckDef>
        <beamStartOffset>0.8</beamStartOffset>
        <beamLineFleckChanceCurve>
          <points>
            <li>(0, 0)</li>
            <li>(0.65, 0.4)</li>
            <li>(1, 0.75)</li>
          </points>
        </beamLineFleckChanceCurve>
      </li>
    </verbs>
    <weaponTags>
      <li>AGM_ThermalLances</li>
    </weaponTags>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>22</power>
        <cooldownTime>1</cooldownTime>
      </li>
    </tools>
  </ThingDef>


<ThingDef ParentName="BaseGun">
    <defName>AGM_Gun_FlashPulse</defName>
    <label>Gun Taldarin</label>
    <description>Gun Taldarin</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Weapon/transparent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.1, 0.1)</drawSize>
    </graphicData>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <relicChance>0</relicChance>
    <statBases>
      <MarketValue>400</MarketValue>
      <Mass>2.6</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>AGM_GunTaldarin</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedHeavy</li>
      <li>LongShots</li>
    </weaponClasses>

    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <warmupTime>0</warmupTime>
        <burstShotCount>1</burstShotCount>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>AGM_Bullet_FlashPulse</defaultProjectile>
        <range>44.9</range>
        <soundCast>Shot_NeedleGun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>40</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>AGM_Bullet_FlashPulse</defName>
    <label>flash pulse</label>
    <graphicData>
      <texPath>Things/Projectile/Needle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <projectile>
      <damageDef>AGM_Damage_AntiArmorShock</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <armorPenetrationBase>1.2</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>90</speed>
    </projectile>
  </ThingDef>
