<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BaseGun">
    <defName>AGM_Gun_MechChaingun</defName>
    <label>mech chaingun</label>
    <description>A powerful chaingun designed for crowd control and suppression. This heavy weapon possess the best armor penetration and inflict both extra bleeding and extra pain against enemies upon impact.</description>
    <graphicData>
      <texPath>Things/Weapons/MechWeapons/MechChaingun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>2.3, 2.3</drawSize>
    </graphicData>
	<equippedAngleOffset>45</equippedAngleOffset>
	<techLevel>Spacer</techLevel>
	<tradeability>None</tradeability>
	<destroyOnDrop>true</destroyOnDrop>
    <soundInteract>AGM_Interact_EnergyWeapon</soundInteract>
    <statBases>
      <MarketValue>6000</MarketValue>
      <Mass>80</Mass>
      <AccuracyTouch>2.0</AccuracyTouch>
      <AccuracyShort>2.0</AccuracyShort>
      <AccuracyMedium>2.0</AccuracyMedium>
      <AccuracyLong>2.0</AccuracyLong>
      <RangedWeapon_Cooldown>4.0</RangedWeapon_Cooldown>
    </statBases>
	<equippedStatOffsets> 
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
		<ai_AvoidFriendlyFireRadius>6</ai_AvoidFriendlyFireRadius>
        <ai_RangedAlawaysShootGroundBelowTarget>true</ai_RangedAlawaysShootGroundBelowTarget>
        <defaultProjectile>AGM_Bullet_MechChaingun</defaultProjectile>
        <warmupTime>1</warmupTime>
        <range>50.9</range>
		<ticksBetweenBurstShots>2</ticksBetweenBurstShots>
        <burstShotCount>30</burstShotCount>
		<minRange>4.9</minRange>
        <soundCast>AGM_Shot_ChainGun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>5</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
	<comps>
    </comps>
    <weaponTags>
      <li>AGM_MechChaingun</li>
    </weaponTags>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>AGM_Bullet_MechChaingun</defName>
    <label>chaingun bullet</label>
    <graphicData>
      <texPath>Things/Misc/Bullets/MechChaingunShot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <shaderType>TransparentPostLight</shaderType>
	  <drawSize>(1.5, 3)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>AGM_Damage_BleedBullets</damageDef>
      <damageAmountBase>12</damageAmountBase>
	  <armorPenetrationBase>3</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>120</speed>
	  <extraDamages>
       <li>
        <amount>9</amount>
        <chance>1.0</chance>
        <def>AGM_Damage_ShockBullets</def>
       </li>
      </extraDamages>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseGun">
    <defName>AGM_Gun_MechLaserBlaster</defName>
    <label>mech laser blaster</label>
    <description>Rapid fire laser blaster with the highest base damage for an automatic energy weapon. Like a chaingun, it can unleash a storm of high power laser projectiles that can take down any threats with excellent efficientcy. Such a weapon is only seen being wielded by heavy-class mechanoids with abundant energy supply stored within them.</description>
    <graphicData>
      <texPath>Things/Weapons/MechWeapons/MechLaserBlaster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>2.0, 2.0</drawSize>
    </graphicData>
	<equippedAngleOffset>45</equippedAngleOffset>
	<techLevel>Spacer</techLevel>
	<tradeability>None</tradeability>
	<destroyOnDrop>true</destroyOnDrop>
    <soundInteract>AGM_Interact_EnergyWeapon</soundInteract>
    <statBases>
      <MarketValue>6000</MarketValue>
      <Mass>80</Mass>
      <AccuracyTouch>1.0</AccuracyTouch>
      <AccuracyShort>1.0</AccuracyShort>
      <AccuracyMedium>1.0</AccuracyMedium>
      <AccuracyLong>1.0</AccuracyLong>
      <RangedWeapon_Cooldown>4.0</RangedWeapon_Cooldown>
    </statBases>
	<equippedStatOffsets> 
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>AGM_Bullet_MechLaserBlaster</defaultProjectile>
        <warmupTime>1</warmupTime>
        <range>50.9</range>
		<ticksBetweenBurstShots>2</ticksBetweenBurstShots>
        <burstShotCount>25</burstShotCount>
		<minRange>4.9</minRange>
        <soundCast>AGM_Shot_LaserBlaster</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
	<comps>
    </comps>
    <weaponTags>
      <li>AGM_MechLaserBlaster</li>
    </weaponTags>
  </ThingDef>

