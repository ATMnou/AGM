      <ControlTakingTime>15</ControlTakingTime>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
    </statBases>
    <race>
      <body>Mech_Light</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.6</baseHealthScale>
      <mechWeightClass>Light</mechWeightClass>
      <mechEnabledWorkTypes>
        <li>Doctor</li>
        <li>Hauling</li>
        <li>Cleaning</li>
      </mechEnabledWorkTypes>
      <mechFixedSkillLevel>10</mechFixedSkillLevel>
    </race>
    <tools>
      <li>
        <label>fists</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>13</power>
        <cooldownTime>1.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
