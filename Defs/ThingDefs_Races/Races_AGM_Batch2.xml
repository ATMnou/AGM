<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- AGM batch 2: nine maidnoids distilled from the model answers. -->
  <!-- Texture work and weight classes: design sheet. Mechanics are  -->
  <!-- trimmed to what a RimWorld mech can actually do.              -->
  <!--                                                               -->
  <!--  Command A+  Light 18   Mimo      Light  5   Mercury Light 9  -->
  <!--  Solar       Light 15   Muse      Med   55   Pareto  Med 100  -->
  <!--  Qwen        Med   80   GLM       Med   58   K3       Hvy 140  -->
  <!-- ============================================================ -->

  <ThingDef Abstract="True" Name="AGM_Batch2Base" ParentName="BaseMechanoid">
    <statBases>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
      <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
    </statBases>
    <comps>
      <li Class="AGM.CompProperties_IgnoreMechanitorCommandRange" />
      <li Class="AGM.CompProperties_DisableFeral" />
    </comps>
    <race>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
  </ThingDef>

  <!-- ==================== COMMAND A+ (Light, 18) ==================== -->
  <ThingDef ParentName="AGM_Batch2Base">
    <defName>AGM_CommandA</defName>
    <label>Command A+</label>
    <description>The AGM line's field commander, trained on every war sim the foundry could license. Command A+ projects a steady presence that keeps everyone under it calm, treats wounds between orders, and answers threats with a cheerful compact beam that purrs before it stings. A pair of loaf-shaped drones orbits it - part escort, part emotional support.</description>
    <statBases>
      <MarketValue>1800</MarketValue>
      <MoveSpeed>4.6</MoveSpeed>
      <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.55</ArmorRating_Sharp>
      <BandwidthCost>1</BandwidthCost>
      <ControlTakingTime>16</ControlTakingTime>
      <EMPResistance>0.4</EMPResistance>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </statBases>
    <race>
      <body>Mech_Light</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.8</baseHealthScale>
      <mechWeightClass>Light</mechWeightClass>
      <mechEnabledWorkTypes>
        <li>Doctor</li>
        <li>Hauling</li>
      </mechEnabledWorkTypes>
      <mechFixedSkillLevel>8</mechFixedSkillLevel>
    </race>
    <tools>
      <li>
        <label>fists</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.1</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_TurretGun">
        <turretDef>AGM_Turret_NyanBeam</turretDef>
        <angleOffset>-90</angleOffset>
      </li>
      <li Class="AGM.CompProperties_AoeAura">
        <radius>10</radius>
        <hediff>AGM_Hediff_CommandAura</hediff>
      </li>
      <li Class="CompProperties_MechCarrier">
        <spawnPawnKind>AGM_CommandDrone</spawnPawnKind>
        <fixedIngredient>Steel</fixedIngredient>
        <costPerPawn>30</costPerPawn>
        <startingIngredientCount>60</startingIngredientCount>
        <maxIngredientCount>60</maxIngredientCount>
        <cooldownTicks>1200</cooldownTicks>
        <maxPawnsToSpawn>2</maxPawnsToSpawn>
      </li>
    </comps>
    <butcherProducts Inherit="False">
      <Steel>60</Steel>
      <Plasteel>30</Plasteel>
    </butcherProducts>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>AGM_CommandA</defName>
    <label>Command A+</label>
    <race>AGM_CommandA</race>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <combatPower>150</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Mechanoid/CommandA</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.0</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <controlGroupPortraitZoom>1.4</controlGroupPortraitZoom>
  </PawnKindDef>

  <!-- Command A+'s orbiting loaf drone -->
  <ThingDef ParentName="LightMechanoid">
    <defName>AGM_CommandDrone</defName>
    <label>command drone</label>
    <description>A loaf-shaped escort drone projected by Command A+. It nudges threats away from its maker until its power cell runs dry.</description>
    <statBases>
      <MoveSpeed>6.5</MoveSpeed>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
    </statBases>
    <race>
      <body>Mech_Light</body>
      <baseBodySize>0.5</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <mechWeightClass>Light</mechWeightClass>
      <thinkTreeConstant>WarUrchinConstant</thinkTreeConstant>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_WarUrchin_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_WarUrchin_Death</soundDeath>
          <soundCall>Pawn_Mech_WarUrchin_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>bumper</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>0.9</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_MechPowerCell">
        <totalPowerTicks>20000</totalPowerTicks>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>AGM_CommandDrone</defName>
    <label>command drone</label>
    <race>AGM_CommandDrone</race>
    <combatPower>60</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <forceNoDeathNotification>true</forceNoDeathNotification>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Mechanoid/CommandA_Drone</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>1.0</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <!-- ==================== MIMO (Light, 5) ==================== -->
  <ThingDef ParentName="AGM_Batch2Base">
    <defName>AGM_Mimo</defName>
    <label>Mimo</label>
    <description>The foundry's smallest field-integration unit, dropped into failing colonies to make things run better. Mimo builds, mines and hauls with cheerful overqualification, and everyone inside her link radius simply works a little faster. Her wrench unfolds into something closer to a verdict when mechanoids are the problem.</description>
    <statBases>
      <MarketValue>500</MarketValue>
      <MoveSpeed>5.0</MoveSpeed>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <BandwidthCost>1</BandwidthCost>
      <ControlTakingTime>12</ControlTakingTime>
      <WorkSpeedGlobal>1.1</WorkSpeedGlobal>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
    </statBases>
    <race>
      <body>Mech_Light</body>
      <baseBodySize>0.9</baseBodySize>
      <baseHealthScale>1.1</baseHealthScale>
      <mechWeightClass>Light</mechWeightClass>
      <mechEnabledWorkTypes>
        <li>Construction</li>
        <li>Mining</li>
        <li>Hauling</li>
        <li>Crafting</li>
      </mechEnabledWorkTypes>
      <mechWorkTypePriorities>
        <Construction>1</Construction>
        <Mining>2</Mining>
        <Hauling>3</Hauling>
        <Crafting>3</Crafting>
      </mechWorkTypePriorities>
      <mechFixedSkillLevel>12</mechFixedSkillLevel>
    </race>
    <tools>
      <li>
        <label>THE MULTI (wrench)</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>0.8</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>Stun</def>
            <amount>8</amount>
            <chance>0.5</chance>
          </li>
        </extraMeleeDamages>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="AGM.CompProperties_AoeAura">
        <radius>8</radius>
        <hediff>AGM_Hediff_MimoSync</hediff>
      </li>
      <li Class="AGM.CompProperties_Overclock">
        <statMultiplier>1.8</statMultiplier>
        <drainPerDay>0.12</drainPerDay>
        <rechargePerDay>0.25</rechargePerDay>
        <iconPath>Things/Abilities/Overclock</iconPath>
      </li>
    </comps>
    <butcherProducts Inherit="False">
      <Steel>40</Steel>
      <Plasteel>20</Plasteel>
    </butcherProducts>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>AGM_Mimo</defName>
    <label>Mimo</label>
    <race>AGM_Mimo</race>
