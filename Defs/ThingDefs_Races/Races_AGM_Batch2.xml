  <!-- ==================== MERCURY (Light, 9) ==================== -->
  <ThingDef ParentName="AGM_Batch2Base">
    <defName>AGM_Mercury</defName>
    <label>Mercury</label>
    <description>The rapid-response frame. Mercury arrives before the shooting starts, phase-blinks out of the way of the return fire, and its pulse lancer files armor under 'solved'. Its targeting core broadcasts firing solutions to itself constantly - the only thing Mercury shares reluctantly is credit.</description>
    <statBases>
      <MarketValue>900</MarketValue>
      <MoveSpeed>5.8</MoveSpeed>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
      <BandwidthCost>1</BandwidthCost>
      <ControlTakingTime>14</ControlTakingTime>
      <EMPResistance>0.3</EMPResistance>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
    </statBases>
    <race>
      <body>Mech_Light</body>
      <baseBodySize>1.1</baseBodySize>
      <baseHealthScale>1.4</baseHealthScale>
      <mechWeightClass>Light</mechWeightClass>
    </race>
    <tools>
      <li>
        <label>fists</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_TurretGun">
        <turretDef>AGM_Turret_PulseLancer</turretDef>
        <angleOffset>-90</angleOffset>
      </li>
      <li Class="AGM.CompProperties_EnsureHediff">
        <hediff>AGM_Hediff_MercuryOverdrive</hediff>
      </li>
      <li Class="AutoBlink.CompProperties_AutoBlink">
        <minDistanceToBlink>6</minDistanceToBlink>
        <maxDistanceToBlink>18</maxDistanceToBlink>
        <blinkIntervalTicks>90</blinkIntervalTicks>
        <delayAfterEligibleTicks>20</delayAfterEligibleTicks>
        <cellsBeforeTarget>2</cellsBeforeTarget>
        <postBlinkStanceTicks>0</postBlinkStanceTicks>
        <defaultAutoBlinkDrafted>true</defaultAutoBlinkDrafted>
        <defaultAutoBlinkIdle>false</defaultAutoBlinkIdle>
        <defaultJumpAsFarAsPossible>false</defaultJumpAsFarAsPossible>
        <excludedJobDefs>
          <li>GotoWander</li>
          <li>Carried</li>
        </excludedJobDefs>
        <drawGizmo>true</drawGizmo>
        <preBlinkSoundDefs>
          <li>AutoBlink_Skip_Small</li>
        </preBlinkSoundDefs>
        <postBlinkSoundDefs>
          <li>AutoBlink_Skip_Exit_Small</li>
        </postBlinkSoundDefs>
        <preBlinkEffecterDefs>
          <li>Skip_Entry</li>
        </preBlinkEffecterDefs>
        <postBlinkEffecterDefs>
          <li>Skip_ExitNoDelay</li>
        </postBlinkEffecterDefs>
        <preBlinkMoteDefs />
        <postBlinkMoteDefs />
      </li>
    </comps>
    <butcherProducts Inherit="False">
      <Steel>50</Steel>
      <Plasteel>30</Plasteel>
    </butcherProducts>
  </ThingDef>

