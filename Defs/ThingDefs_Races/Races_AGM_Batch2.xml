  <!-- ==================== SOLAR (Light, 15) ==================== -->
  <ThingDef ParentName="AGM_Batch2Base">
    <defName>AGM_Solar</defName>
    <label>Solar</label>
    <description>The pragmatic courier-chassis. Solar reads a fight before committing, holds angles behind a short-range barrier pulse, and defuses half of every argument with a focused photon lance. Dependable rather than flashy - the foundry graded it on judgment, and it kept the certificate.</description>
    <statBases>
      <MarketValue>1500</MarketValue>
      <MoveSpeed>4.8</MoveSpeed>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
