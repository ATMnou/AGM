        <minIdleAlpha>0.15</minIdleAlpha>
        <disarmedByEmpForTicks>900</disarmedByEmpForTicks>
        <gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
      </li>
    </comps>
    <butcherProducts Inherit="False">
      <Steel>55</Steel>
      <Plasteel>30</Plasteel>
    </butcherProducts>
  </ThingDef>

