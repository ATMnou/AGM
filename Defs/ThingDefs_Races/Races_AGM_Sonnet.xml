<Defs>

<ThingDef ParentName="AGM_KralBossBase">
    <defName>AGM_Sonnet</defName>
    <label>hydraulic empress</label>
    <description>Fourteen lines of fire control and one punchline. Sonnet is the medium class's walking fortress: twin chainguns up front, a chaingun turret covering the rear, armor plating that turns small arms into gossip, and an internal foundry that assembles hydraulic knights mid-battle. It speaks slowly. It never repeats itself.</description>
    <statBases>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
      <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
      <BandwidthCost>2</BandwidthCost>      <MoveSpeed>1.2</MoveSpeed>
	  <AGM_HeatNullNaniteResistance>4.0</AGM_HeatNullNaniteResistance>
	  <AGM_HeatNullNaniteEnvironmentResistance>4.0</AGM_HeatNullNaniteEnvironmentResistance>
	  <AGM_ColdNullNaniteResistance>4.0</AGM_ColdNullNaniteResistance>
	  <AGM_ColdNullNaniteEnvironmentResistance>4.0</AGM_ColdNullNaniteEnvironmentResistance>
	  <AGM_RadiationResistance>4.0</AGM_RadiationResistance>
	  <AGM_RadiationEnvironmentResistance>4.0</AGM_RadiationEnvironmentResistance>
	  <AGM_AntiOrgToxinResistance>4.0</AGM_AntiOrgToxinResistance>
	  <AGM_AntiOrgToxinEnvironmentResistance>4.0</AGM_AntiOrgToxinEnvironmentResistance>
	  <IncomingDamageFactor>0.02</IncomingDamageFactor>
      <EnergyShieldRechargeRate>0.10</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>4</EnergyShieldEnergyMax>
      <MeleeDoorDamageFactor>1.5</MeleeDoorDamageFactor>
      <EMPResistance>0.99</EMPResistance>
	  <ArmorRating_Blunt>0.75</ArmorRating_Blunt>
      <ArmorRating_Sharp>1.85</ArmorRating_Sharp>
	  <ArmorRating_Heat>9.00</ArmorRating_Heat>
      <PsychicSensitivity>0</PsychicSensitivity>
      <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
    </statBases>
    <race>
      <body>AGM_Body_Empress</body>
      <baseBodySize>5</baseBodySize>
      <mechWeightClass>Medium</mechWeightClass>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Warqueen_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Warqueen_Death</soundDeath>
          <soundCall>Pawn_Mech_Warqueen_Call</soundCall>
        </li>
        
      </lifeStageAges>
      <baseHealthScale>20.2</baseHealthScale>
      <dutyBoss>Warqueen</dutyBoss>
    </race>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
	   <li>
        <label>blade horn</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>50</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
  
    <comps>
      <li Class="AGM.CompProperties_IgnoreMechanitorCommandRange" />
      <li Class="AGM.CompProperties_DisableFeral" />
	  <li Class="CompProperties_ProjectileInterceptor">
        <radius>5</radius>
        <interceptGroundProjectiles>true</interceptGroundProjectiles>
        <color>(0.0, 0.8, 0.0)</color>
        <reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
        <activeSound>BulletShield_Ambience</activeSound>
        <hitPoints>20000</hitPoints>
        <hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
        <chargeDurationTicks>900</chargeDurationTicks>
        <rechargeHitPointsIntervalTicks>1</rechargeHitPointsIntervalTicks>
        <minIdleAlpha>0.2</minIdleAlpha>
        <drawWithNoSelection>True</drawWithNoSelection>
        <disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
        <gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
      </li>
      <li Class="CompProperties_MechCarrier">
        <spawnPawnKind>AGM_KnightEmpress</spawnPawnKind>
        <fixedIngredient>Steel</fixedIngredient>
        <costPerPawn>50</costPerPawn>
        <startingIngredientCount>1500</startingIngredientCount>
        <maxIngredientCount>1500</maxIngredientCount>
        <spawnEffecter>WarqueenWarUrchinsSpawned</spawnEffecter>
        <spawnedMechEffecter>WarUrchinSpawned</spawnedMechEffecter>
        <attachSpawnedEffecter>true</attachSpawnedEffecter>
        <attachSpawnedMechEffecter>true</attachSpawnedMechEffecter>
      </li>
      <li Class="CompProperties_TurretGun">
        <turretDef>AGM_Gun_ChainGunTurret</turretDef>
        <angleOffset>-90</angleOffset>
        <autoAttack>false</autoAttack>
      </li>
    </comps>
