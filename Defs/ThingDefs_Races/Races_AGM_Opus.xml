<Defs>

<ThingDef ParentName="AGM_KralBossBase">
    <defName>AGM_Opus</defName>
    <label>dragon warlord</label>
    <description>The AGM line's long-form model: it composes slowly and resolves absolutely. Opus holds the line behind a monstrous shield bubble, answers at range with a mech laser blaster, fabricates its own dragon-knight retinue in the field, and raises the fallen back into the fight. Survivors of an Opus engagement all report the same lesson - the battle ends when Opus decides it ends.</description>
    <statBases>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
      <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
      <BandwidthCost>3</BandwidthCost>      <MoveSpeed>2.5</MoveSpeed>
	  <AGM_HeatNullNaniteResistance>4.0</AGM_HeatNullNaniteResistance>
	  <AGM_HeatNullNaniteEnvironmentResistance>4.0</AGM_HeatNullNaniteEnvironmentResistance>
	  <AGM_ColdNullNaniteResistance>4.0</AGM_ColdNullNaniteResistance>
	  <AGM_ColdNullNaniteEnvironmentResistance>4.0</AGM_ColdNullNaniteEnvironmentResistance>
	  <AGM_RadiationResistance>4.0</AGM_RadiationResistance>
	  <AGM_RadiationEnvironmentResistance>4.0</AGM_RadiationEnvironmentResistance>
	  <AGM_AntiOrgToxinResistance>4.0</AGM_AntiOrgToxinResistance>
	  <AGM_AntiOrgToxinEnvironmentResistance>4.0</AGM_AntiOrgToxinEnvironmentResistance>
	  <IncomingDamageFactor>0.02</IncomingDamageFactor>
      <EnergyShieldRechargeRate>1.2</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>10</EnergyShieldEnergyMax>
      <MeleeDoorDamageFactor>1.5</MeleeDoorDamageFactor>
