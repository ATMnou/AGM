    <race>
      <body>AGM_Body_Warlord</body>
      <baseBodySize>5</baseBodySize>
      <mechWeightClass>Heavy</mechWeightClass>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Apocriton_Wounded</soundWounded>
          <soundAngry>Pawn_Mech_Apocriton_Call</soundAngry>
          <soundDeath>Pawn_Mech_Apocriton_Death</soundDeath>
          <soundCall>Pawn_Mech_Apocriton_Call</soundCall>
        </li>
        
      </lifeStageAges>
      <baseHealthScale>30.2</baseHealthScale>
      <dutyBoss>Warqueen</dutyBoss>
    </race>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  
    <comps>
      <li Class="AGM.CompProperties_IgnoreMechanitorCommandRange" />
      <li Class="AGM.CompProperties_DisableFeral" />
	  <li Class="CompProperties_ProjectileInterceptor">
        <radius>5</radius>
        <interceptGroundProjectiles>true</interceptGroundProjectiles>
        <color>(0.0, 0.8, 0.0)</color>
        <reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
        <activeSound>BulletShield_Ambience</activeSound>
        <hitPoints>40000</hitPoints>
        <hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
        <chargeDurationTicks>900</chargeDurationTicks>
        <rechargeHitPointsIntervalTicks>1</rechargeHitPointsIntervalTicks>
        <minIdleAlpha>0.2</minIdleAlpha>
        <drawWithNoSelection>True</drawWithNoSelection>
        <disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
        <gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
      </li>
      <li Class="CompProperties_MechCarrier">
        <spawnPawnKind>AGM_KnightWarlord</spawnPawnKind>
        <fixedIngredient>Steel</fixedIngredient>
        <costPerPawn>50</costPerPawn>
        <startingIngredientCount>1000</startingIngredientCount>
        <maxIngredientCount>1000</maxIngredientCount>
        <spawnEffecter>WarqueenWarUrchinsSpawned</spawnEffecter>
        <spawnedMechEffecter>WarUrchinSpawned</spawnedMechEffecter>
        <attachSpawnedEffecter>true</attachSpawnedEffecter>
        <attachSpawnedMechEffecter>true</attachSpawnedMechEffecter>
      </li>
    </comps>
