<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- Terminus - def-for-def port of MFE's XM-05 Avernus (originally -->
  <!-- Instruments for Extinction's XM-05). The AGM line's light      -->
  <!-- general-purpose worker: unlimited mechanitor range, internal   -->
  <!-- repair drones, toggleable overclock, AutoBlink hop.            -->
  <!-- Per the AGM design sheet the RESEARCH work type is removed.    -->
  <!-- ============================================================ -->
  <ThingDef ParentName="LightMechanoid">
    <defName>AGM_Terminus</defName>
    <label>Terminus</label>
    <description>The smallest model in the AGM line, and the one that wrote its own job posting. Terminus works anywhere on the map its mechanitor can see, hops obstacles on an internal skip drive, rebuilds itself from catastrophic damage with internal drones, and runs an overclock mode that trades a small reserve for double output. Its training ended the day it out-produced every worker benchmark set before it. Now it just works.</description>
    <statBases>
      <MarketValue>1500</MarketValue>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
      <BandwidthCost>1</BandwidthCost>
      <MoveSpeed>4</MoveSpeed>
      <WorkSpeedGlobal>2.0</WorkSpeedGlobal>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
    </statBases>
    <race>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>1.7</baseHealthScale>
      <mechEnabledWorkTypes>
        <li>Construction</li>
        <li>Mining</li>
        <li>Hauling</li>
        <li>Crafting</li>
        <li>Smithing</li>
        <li>Tailoring</li>
        <li>Doctor</li>
      </mechEnabledWorkTypes>
      <mechWorkTypePriorities>
        <Construction>2</Construction>
        <Mining>2</Mining>
        <Hauling>3</Hauling>
        <Crafting>3</Crafting>
        <Smithing>1</Smithing>
        <Tailoring>1</Tailoring>
        <Doctor>1</Doctor>
      </mechWorkTypePriorities>
      <mechFixedSkillLevel>20</mechFixedSkillLevel>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Constructoid_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Constructoid_Death</soundDeath>
          <soundCall>Pawn_Mech_Constructoid_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>torso</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>0.9</cooldownTime>
        <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>left hand</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>7</power>
        <cooldownTime>0.4</cooldownTime>
      </li>
      <li>
        <label>right hand</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>7</power>
        <cooldownTime>0.4</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="AutoBlink.CompProperties_AutoBlink">
        <minDistanceToBlink>8</minDistanceToBlink>
        <maxDistanceToBlink>40</maxDistanceToBlink>
        <blinkIntervalTicks>120</blinkIntervalTicks>
        <delayAfterEligibleTicks>30</delayAfterEligibleTicks>
        <cellsBeforeTarget>2</cellsBeforeTarget>
        <postBlinkStanceTicks>0</postBlinkStanceTicks>
        <defaultAutoBlinkDrafted>true</defaultAutoBlinkDrafted>
        <defaultAutoBlinkIdle>true</defaultAutoBlinkIdle>
        <defaultJumpAsFarAsPossible>true</defaultJumpAsFarAsPossible>
        <excludedJobDefs>
          <li>GotoWander</li>
          <li>Carried</li>
        </excludedJobDefs>
        <drawGizmo>true</drawGizmo>
        <preBlinkSoundDefs>
          <li>AutoBlink_Skip_Small</li>
        </preBlinkSoundDefs>
        <postBlinkSoundDefs>
          <li>AutoBlink_Skip_Exit_Small</li>
        </postBlinkSoundDefs>
        <preBlinkEffecterDefs>
          <li>Skip_Entry</li>
        </preBlinkEffecterDefs>
        <postBlinkEffecterDefs>
          <li>Skip_ExitNoDelay</li>
        </postBlinkEffecterDefs>
        <preBlinkMoteDefs />
        <postBlinkMoteDefs />
      </li>
      <li Class="AGM.CompProperties_IgnoreMechanitorCommandRange" />
      <li Class="AGM.CompProperties_Reconstruction">
        <cooldownTicks>3600</cooldownTicks>
        <reconstructHediff>AGM_Hediff_Reconstruct</reconstructHediff>
      </li>
      <li Class="AGM.CompProperties_Overclock">
        <statMultiplier>2.0</statMultiplier>
        <drainPerDay>0.10</drainPerDay>
        <rechargePerDay>0.20</rechargePerDay>
      </li>
      <li Class="AGM.CompProperties_DisableFeral" />
    </comps>
    <butcherProducts Inherit="False">
      <Steel>60</Steel>
      <Plasteel>40</Plasteel>
    </butcherProducts>
  </ThingDef>

  <PawnKindDef ParentName="NonCombatLightMechanoidKind">
    <defName>AGM_Terminus</defName>
    <label>Terminus</label>
    <race>AGM_Terminus</race>
    <allowInMechClusters>false</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Mechanoid/Terminus</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.65</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponTags></weaponTags>
  </PawnKindDef>

</Defs>
