<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- EXAONE - the AGM line's heavy melee brawler. Rendered      -->
  <!-- entirely by an animated sprite loop (Hellclown idle,       -->
  <!-- 18 frames) instead of the standard mechanoid render tree.  -->
  <!-- A close-combat tank: heavy armor, grinning claws, and      -->
  <!-- three map-wide roars (retreat / frenzy / ruin).            -->
  <!-- ============================================================ -->
  <ThingDef ParentName="BaseMechanoid">
    <defName>AGM_Exaone</defName>
    <label>Exaone</label>
    <description>EXAONE should not exist. Its chassis was assembled around an unlicensed visual layer - a grinning warframe loop harvested from somewhere outside the foundry's archive, idling with the slow sway of a clown drifting through higher realms - and nobody on record approved it. In battle it is a wall of scarlet appetite: its retreating roar sends human raiders fleeing, its frenzied roar drives raiders berserk, and its ruinous roar breaks every raider's body in measure of their strength. Officially the model does not exist. Unofficially, it keeps laughing.</description>
    <statBases>
      <MarketValue>45000</MarketValue>
      <MoveSpeed>4.6</MoveSpeed>
      <ArmorRating_Blunt>1.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <BandwidthCost>3</BandwidthCost>
      <ControlTakingTime>30</ControlTakingTime>
      <EMPResistance>0.5</EMPResistance>
      <PsychicSensitivity>0.4</PsychicSensitivity>
      <MechEnergyLossPerHP>0.2</MechEnergyLossPerHP>
      <MechEnergyUsageFactor>0</MechEnergyUsageFactor>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
    </statBases>
    <race>
      <body>Mech_Light</body>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <baseBodySize>2.2</baseBodySize>
      <baseHealthScale>5.0</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
      <renderTree>AGM_Exaone</renderTree>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Diabolus_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Diabolus_Death</soundDeath>
          <soundCall>Pawn_Mech_Diabolus_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <comps>
      <li Class="AGM.CompProperties_ExaoneRoars">
        <retreatCooldownTicks>120000</retreatCooldownTicks>
        <frenzyCooldownTicks>180000</frenzyCooldownTicks>
        <damageCooldownTicks>180000</damageCooldownTicks>
      </li>
      <li Class="AGM.CompProperties_IgnoreMechanitorCommandRange" />
      <li Class="AGM.CompProperties_DisableFeral" />
    </comps>
    <tools>
      <li>
        <label>grinning left claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>34</power>
        <armorPenetration>0.60</armorPenetration>
        <cooldownTime>1.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>grinning right claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>34</power>
        <armorPenetration>0.60</armorPenetration>
        <cooldownTime>1.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <butcherProducts Inherit="False">
      <Steel>80</Steel>
      <Plasteel>60</Plasteel>
    </butcherProducts>
  </ThingDef>

  <PawnKindDef ParentName="HeavyMechanoidKind">
    <defName>AGM_Exaone</defName>
    <label>Exaone</label>
    <race>AGM_Exaone</race>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <combatPower>850</combatPower>
    <maxPerGroup>1</maxPerGroup>
    <allowInMechClusters>false</allowInMechClusters>
    <!-- static first-frame graphic: satisfies lifeStage parity with the race def and
         provides the archive/architect icon (the animated render tree handles in-world drawing) -->
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Mechanoid/Exaone/ExaoneF-00</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <shaderType>Cutout</shaderType>
          <drawSize>4.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponTags></weaponTags>
    <controlGroupPortraitZoom>1.0</controlGroupPortraitZoom>
  </PawnKindDef>

</Defs>
